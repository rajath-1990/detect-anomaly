# Copy to backend/.env and fill in.
#
# Leave GOOGLE_APPLICATION_CREDENTIALS unset to run fully offline: the engine,
# the graph and both simulators work without any Firebase project. Only Android
# sync needs it.

PORT=8000

# Absolute path to the Firebase service-account JSON.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# NEVER commit this file.
# GOOGLE_APPLICATION_CREDENTIALS=D:\hackathon\backend\serviceAccountKey.json
